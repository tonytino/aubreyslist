{
  "$schema": "https://biomejs.dev/schemas/2.5.5/schema.json",
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUnusedVariables": "error",
        "noUnusedImports": "error"
      },
      "suspicious": {
        "noExplicitAny": "error"
      }
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "trailingCommas": "es5",
      "semicolons": "always"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "files": {
    "includes": [
      "**",
      "!**/app/routeTree.gen.ts",
      "!**/scripts/*.generated.json",
      "!**/node_modules",
      "!**/.output",
      "!**/.nitro",
      "!**/.tanstack",
      "!**/dist",
      "!**/.claude",
      "!**/test-results",
      "!**/playwright-report",
      "!**/coverage",
      "!**/.stryker-tmp",
      "!**/reports"
    ]
  }
}
