# Neon serverless Postgres connection string. (Required)
# Get one at https://neon.tech → New Project → Connection Details.
# This template uses Neon's HTTP driver (drizzle-orm/neon-http), so the pooled
# vs. direct endpoint doesn't matter — either connection string works. (The
# -pooler endpoint is for the WebSocket `Pool` driver, which this template
# doesn't use.)
# Format: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=

# Google OAuth client ID + secret (safe:human, provisioned by a human).
# Google Cloud Console → APIs & Services → Credentials → Create Credentials →
# OAuth client ID (Web application). See docs/setup/provisioning.md (#14) and
# ADR-006. Stay optional in app/env.ts (CI lacks them); the auth routes (#15)
# guard at point of use and error clearly if a sign-in is attempted unset.
# Authorized redirect URI must be: <origin>/api/auth/callback/google
#   (local: http://localhost:3000/api/auth/callback/google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google Places server-side API key (safe:human, provisioned by a human).
# Same Google Cloud project → Enable the Places API → Credentials → Create
# Credentials → API key, then restrict it to the Places API. Server-side only —
# never expose to the browser. See docs/setup/provisioning.md (#21) and ADR-008.
# Optional in app/env.ts until the Places provider issue (#22) requires it.
GOOGLE_PLACES_API_KEY=

# Google Maps BROWSER key for the directory map (AUB-111; provisioned by a
# human via AUB-217). PUBLIC BY DESIGN — the `VITE_` prefix makes Vite inline
# it into the client bundle, which is how the Maps JavaScript API works; it is
# NOT a secret. Protect it in the Google Cloud console instead: HTTP-referrer
# restriction to this app's domains + API restriction to the Maps JavaScript
# API only. It is a DIFFERENT key from GOOGLE_PLACES_API_KEY (server-side,
# secret). Optional: when absent/blank the map view renders its deterministic
# CSS-placeholder fallback (CI/E2E rely on that). Read it only via
# app/lib/public-env.ts — never raw import.meta.env.
VITE_GOOGLE_MAPS_BROWSER_KEY=

# Session signing secret (safe:human, provisioned by a human).
# Must be at least 32 characters — it protects every session cookie, so a short
# value would be weak. Generate one with `openssl rand -base64 32`. See
# docs/setup/provisioning.md (#14) and ADR-006. Optional in app/env.ts until
# the auth issue (#15) requires it.
SESSION_SECRET=

# Vercel deployment environment (auto-set by Vercel: `production` | `preview` |
# `development`). Injected only on Vercel; leave BLANK locally UNLESS you want
# the preview dev-login to work on localhost — set `VERCEL_ENV=development` for
# that (otherwise use real Google on localhost, whose callback is registered).
# The dev-login endpoint is fail-closed: it enables ONLY for `preview` or
# `development`; unset/`production`/anything else keeps it disabled. See AUB-138.
VERCEL_ENV=

# Preview-only dev-login secret (safe:human, provisioned by a human).
# Gates GET /api/auth/dev-login, which mints a session WITHOUT Google so a
# tester can sign in on a Vercel per-deployment preview URL. Must be at least
# 32 characters; generate one with `openssl rand -base64 32`.
# Provision it as a **Preview-scoped** Vercel env var — NEVER Production (the
# endpoint 404s in production regardless, but keep the secret out of prod).
# Optional in app/env.ts; when absent the endpoint is disabled. See AUB-138.
PREVIEW_LOGIN_SECRET=
