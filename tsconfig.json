{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",

    // Strict
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,

    // Paths
    // `baseUrl` is deprecated as of TypeScript 6.0 (removed in 7.0 — see
    // https://aka.ms/ts6). It was set to "." (the tsconfig.json directory),
    // which is also the default base for "paths" when baseUrl is absent, so
    // dropping it is a no-op for module resolution.
    "paths": {
      // More specific first: ~/db/* resolves to the repo-root db/ directory,
      // everything else under ~/ resolves to app/.
      "~/db/*": ["./db/*"],
      "~/*": ["./app/*"]
    },

    // TS 6.0 no longer picks up @types/node's globals (process, Buffer) via
    // automatic @types inclusion under moduleResolution "Bundler" — list it
    // explicitly. Safe: react/react-dom types arrive via imports, not globals.
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["app", "tests", "db", "scripts"]
}
