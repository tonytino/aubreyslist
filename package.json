{
  "name": "aubreyslist",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@11.9.0+sha512.bd682d5d03fe525ef7c9fd6780c6884d1e756ac4c9c9fe00c538782824310dcf90e3ddc4f53835f06dfaebd5085e41855e0bcbb3b60de2ac5bbab89e5036f03b",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "node .output/server/index.mjs",
    "check": "biome check --write .",
    "preflight": "biome check . && tsc --noEmit && vitest run",
    "lint": "biome lint --write .",
    "format": "biome format --write .",
    "changelog:preview": "node scripts/changelog.mjs preview",
    "changelog:check": "node scripts/changelog.mjs check",
    "changelog:release": "node scripts/changelog.mjs release",
    "typecheck": "tsc --noEmit",
    "deadcode": "knip",
    "duplication": "jscpd",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install --with-deps",
    "test:mutation": "stryker run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:verify": "node --experimental-strip-types --import ./scripts/register-aliases.mjs ./scripts/verify-migrations.ts",
    "db:studio": "drizzle-kit studio",
    "db:seed-admin": "node --experimental-strip-types --import ./scripts/register-aliases.mjs ./scripts/seed-admin.ts",
    "db:seed": "node --experimental-strip-types --import ./scripts/register-aliases.mjs ./scripts/seed.ts",
    "db:seed:refresh": "node --experimental-strip-types --import ./scripts/register-aliases.mjs ./scripts/refresh-seed-data.ts",
    "db:seed:expand-chains": "node --experimental-strip-types --import ./scripts/register-aliases.mjs ./scripts/expand-chain-locations.ts",
    "db:backfill:maps-urls": "node --experimental-strip-types --import ./scripts/register-aliases.mjs ./scripts/backfill-maps-urls.ts",
    "db:backfill:listing-links": "node --experimental-strip-types --import ./scripts/register-aliases.mjs ./scripts/backfill-listing-links.ts",
    "postinstall": "tsr generate",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.1",
    "@neondatabase/serverless": "^1.1.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@sentry/tanstackstart-react": "^10.73.0",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-router": "^1.170.32",
    "@tanstack/react-router-with-query": "^1.130.17",
    "@tanstack/react-start": "^1.168.49",
    "@vercel/analytics": "^2.0.1",
    "@vis.gl/react-google-maps": "^1.10.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.7",
    "iron-webcrypto": "^2.0.0",
    "lucide-react": "^1.41.0",
    "motion": "^13.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "^2.5.12",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@playwright/test": "^1.63.0",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/nitro-v2-vite-plugin": "^1.155.0",
    "@tanstack/router-cli": "^1.167.33",
    "@tanstack/start-storage-context": "^1.167.29",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/google.maps": "^3.66.2",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "drizzle-kit": "^0.31.10",
    "jscpd": "^5.1.2",
    "jsdom": "^30.0.1",
    "knip": "^6.34.0",
    "lefthook": "^2.1.12",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.10"
  },
  "description": "A web app built from the construct template."
}
